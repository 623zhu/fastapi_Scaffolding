COMPOSE_PROJECT_NAME=fastapi-vue-starter
APP_NAME=FastAPI Vue Starter
ENVIRONMENT=development
DEBUG=false
API_V1_PREFIX=/api/v1
BACKEND_PORT=8001
FRONTEND_PORT=8080
FRONTEND_DEV_PORT=5173

MYSQL_HOST=mysql
MYSQL_PORT=3306
MYSQL_DATABASE=app
MYSQL_USER=app
MYSQL_PASSWORD=dev-password
MYSQL_ROOT_PASSWORD=dev-root-password

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=dev-redis-password
